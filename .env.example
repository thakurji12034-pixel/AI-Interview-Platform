# Domain for automatic HTTPS with Caddy (e.g. interview.example.com)
DOMAIN=your-domain.example.com

# Database settings
DB_NAME=interview_platform
DB_ROOT_PASSWORD=replace_with_strong_root_password
DB_PASSWORD=replace_with_strong_db_password

# Authentication secrets
# Generate strong 32-byte hex secrets using: openssl rand -hex 32
JWT_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars
