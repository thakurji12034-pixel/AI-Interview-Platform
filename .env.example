# Domain for automatic HTTPS with Caddy (production deployment)
DOMAIN=your-domain.example.com

# Server configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_NAME=interview_platform
DB_USER=root
DB_PASS=replace_with_your_db_password
DB_ROOT_PASSWORD=replace_with_strong_root_password
DB_PASSWORD=replace_with_strong_db_password

# Authentication secrets (generate using: openssl rand -hex 32)
JWT_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars

# Redis configuration (BullMQ, rate limit, cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Development provider toggles (in-memory mock fallback)
ALLOW_MOCK_PROVIDERS=true
ALLOW_INMEMORY_REDIS=true
REDIS_MOCK=true
