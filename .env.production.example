# ==============================================================================
# IntelliPrep AI – Production Environment Variables Template
# ==============================================================================
# Copy this file to '.env' on your production cloud VM:
#   cp .env.production.example .env
#
# IMPORTANT:
# - NEVER commit your real '.env' file or production secrets to Git.
# - Ensure file permissions restrict read access: chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Networking (Caddy Automatic HTTPS)
# ------------------------------------------------------------------------------
# Fully-qualified domain name (FQDN) pointed to your VM's public elastic IP.
# Example: intelliprep.duckdns.org or assess.yourcompany.com
DOMAIN=your-domain.example.com

# ------------------------------------------------------------------------------
# 2. Application Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://${DOMAIN}

# ------------------------------------------------------------------------------
# 3. MySQL 8 Database Configuration
# ------------------------------------------------------------------------------
# In Docker Compose, the database service is named 'db'.
DB_HOST=db
DB_NAME=interview_platform
DB_USER=interview_app

# Generate strong database passwords:
# Run: openssl rand -hex 16
DB_PASSWORD=replace_with_strong_application_db_password
DB_ROOT_PASSWORD=replace_with_strong_root_admin_password

# ------------------------------------------------------------------------------
# 4. Cryptographic Authentication Secrets (JWT)
# ------------------------------------------------------------------------------
# MUST be cryptographically random strings of at least 32 characters (64 hex characters recommended).
# Generate each secret independently in your terminal using:
#   openssl rand -hex 32
JWT_SECRET=replace_with_openssl_generated_32_byte_hex_secret_key_1
JWT_REFRESH_SECRET=replace_with_openssl_generated_32_byte_hex_secret_key_2

# ------------------------------------------------------------------------------
# 5. Redis Cache & Job Queues (BullMQ)
# ------------------------------------------------------------------------------
# In Docker Compose, the redis service is named 'redis'.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Production Security & Provider Policies (Mandatory)
# ------------------------------------------------------------------------------
# In production, dev registration bypasses and mock overrides are strictly forbidden.
ALLOW_DEV_INTERVIEWER_REGISTRATION=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_INMEMORY_REDIS=false
REDIS_MOCK=false

# ------------------------------------------------------------------------------
# 7. AI Engine & LLM Provider (Optional / Production Tier)
# ------------------------------------------------------------------------------
# Google Gemini API key for production evaluation and mock interviews:
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 8. Multi-Tenant Code Execution (Judge0 / Sandboxed Cluster)
# ------------------------------------------------------------------------------
# Endpoint for isolated Judge0 multi-language compiler runner:
EXECUTION_PROVIDER=mock
JUDGE0_ENDPOINT=http://localhost:2358
JUDGE0_API_KEY=

