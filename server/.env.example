# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
DB_HOST=localhost
DB_NAME=interview_platform
DB_USER=interview_app
DB_PASS=your_db_password

# Authentication secrets (generate using: openssl rand -hex 32)
JWT_SECRET=your_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters

# Development-only flags (must be false in production)
ALLOW_DEV_INTERVIEWER_REGISTRATION=false

# Redis configuration (Phase 3: Rate limiting, caching, BullMQ job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MOCK=false
REDIS_ENABLED=true

# Code Execution engine (Phase 5: Secure execution via Judge0 or in-memory mock)
EXECUTION_PROVIDER=mock
JUDGE0_ENDPOINT=http://localhost:2358
JUDGE0_API_KEY=

# AI Engine & Resume Intelligence (Phase 6: Google Gemini SDK & mock fallback)
AI_MOCK_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash



