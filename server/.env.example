# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
DB_HOST=localhost
DB_NAME=interview_platform
DB_USER=interview_app
DB_PASS=your_db_password

# Authentication secrets (generate using: openssl rand -hex 32)
JWT_SECRET=your_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters

# Development-only flags (must be false in production)
ALLOW_DEV_INTERVIEWER_REGISTRATION=false
